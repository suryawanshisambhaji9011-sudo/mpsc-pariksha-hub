function generateQuestionBank(baseQuestions, totalCount) {
  const generated = [];
  for (let i = 0; i < totalCount; i++) {
    const base = baseQuestions[i % baseQuestions.length];
    generated.push({
      id: i + 1,
      question: `${base.question} (प्रश्न क्रमांक ${i + 1})`,
      options: [...base.options],
      correctAnswer: base.correctAnswer,
      explanation: base.explanation,
      difficulty: i % 4 === 0 ? "सोपे" : i % 4 === 1 ? "मध्यम" : i % 4 === 2 ? "कठिण" : "अतिशय कठिण",
      category: base.category || "general"
    });
  }
  return generated;
}

